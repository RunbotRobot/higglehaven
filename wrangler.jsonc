{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "higglehaven",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "higglehaven-db",
      "database_id": "3d9ad5a2-7529-4fd2-9b2f-60604b0499a1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "higglehaven-models"
    },
    {
      "binding": "DB_BACKUPS",
      "bucket_name": "higglehaven-db-backups"
    }
  ],
  "routes": [
    { "pattern": "higglehaven.com", "custom_domain": true },
    { "pattern": "www.higglehaven.com", "custom_domain": true }
  ],
  // Drives the default export's scheduled() handler in worker/index.js —
  // automatic world growth (checks the greenbelt ratio, expands/generates
  // land if it's dropped below world_settings.greenbelt_min_ratio). Every
  // 10 minutes is frequent enough that a real gap in claimable land is
  // rare and short-lived, without running so often it's ever meaningfully
  // racing itself (a full growth cycle is a handful of D1 round trips, not
  // a long-running job).
  // #1135: a once-daily full D1 data backup to the DB_BACKUPS R2 bucket
  // (backupDatabaseToR2, worker/index.js) -- separate from the */10 tick
  // above since a full-table dump is comparatively expensive and has no
  // reason to run more than once a day. scheduled() distinguishes the two
  // via event.cron (DB_BACKUP_CRON_EXPRESSION), so keep that constant in
  // sync with this literal if it ever changes.
  "triggers": {
    "crons": ["*/10 * * * *", "0 3 * * *"]
  }
}
