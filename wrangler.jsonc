{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "higglehaven",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "higglehaven-db",
      "database_id": "3d9ad5a2-7529-4fd2-9b2f-60604b0499a1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "higglehaven-models"
    }
  ]
}
