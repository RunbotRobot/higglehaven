# #3737 (part of #3735): cache rules for the Worker's static assets (wrangler `assets`
# serves ./dist, and Vite copies this file there from public/). Without it every
# response carries `max-age=0, must-revalidate`, so each open spent a round trip on
# every file before anything could run, including files whose name carries a hash.
#
# Rules do not overlap: this file's matching rules are merged, so a path that two
# rules matched would get two Cache-Control values.

# Content-hashed build output (index-<hash>.js, index-<hash>.css, three-<hash>.js). A new
# build is a new name, so the same name always means the same bytes: keep it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed images and the seed models. They rarely change and are not code, so the phone
# uses its copy at once for an hour and refreshes it in the background for a day after.
/wordmark.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/bird-standing.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/bird-flying.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/models/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Deliberately NOT listed, so they keep the default (revalidate on every open, a 304 when
# unchanged): index.html and every other page, and viewport-refresh.js (a script in the
# head). A deploy is picked up on the next open because index.html names the new hashed files.
